rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    match /siteContent/main {
      allow read: if true;
      allow write: if true;
    }
    
    match /experiences/{experienceId} {
      allow read: if true;
      allow write: if isValidId(experienceId);
    }
    
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isValidId(skillId);
    }
    
    match /certifications/{certId} {
      allow read: if true;
      allow write: if isValidId(certId);
    }
    
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if isValidId(portfolioId);
    }
  }
}
