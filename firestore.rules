rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    match /siteContent/main {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['title', 'aboutTitle', 'aboutSubtitle', 'aboutDescription', 'aboutGoal', 'aboutImageUrl']) 
        && request.resource.data.title is string && request.resource.data.title.size() <= 128
        && request.resource.data.aboutTitle is string && request.resource.data.aboutTitle.size() <= 256
        && request.resource.data.aboutSubtitle is string && request.resource.data.aboutSubtitle.size() <= 256
        && request.resource.data.aboutDescription is string && request.resource.data.aboutDescription.size() <= 2000
        && request.resource.data.aboutGoal is string && request.resource.data.aboutGoal.size() <= 512
        && request.resource.data.aboutImageUrl is string && request.resource.data.aboutImageUrl.size() <= 2000;
    }
    
    match /experiences/{experienceId} {
      allow read: if true;
      allow write: if isValidId(experienceId)
        && request.resource.data.keys().hasAll(['title', 'description', 'sortOrder'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 256
        && request.resource.data.description is string && request.resource.data.description.size() <= 1000
        && request.resource.data.sortOrder is int;
    }
    
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isValidId(skillId)
        && request.resource.data.keys().hasAll(['name', 'sortOrder'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 128
        && request.resource.data.sortOrder is int;
    }
    
    match /certifications/{certId} {
      allow read: if true;
      allow write: if isValidId(certId)
        && request.resource.data.keys().hasAll(['title', 'subtitle', 'icon', 'sortOrder'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 256
        && request.resource.data.subtitle is string && request.resource.data.subtitle.size() <= 256
        && request.resource.data.icon is string && request.resource.data.icon.size() <= 128
        && request.resource.data.sortOrder is int;
    }
    
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if isValidId(portfolioId)
        && request.resource.data.keys().hasAll(['title', 'description', 'tags', 'imageUrl', 'sortOrder', 'isVisible'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 256
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000
        && request.resource.data.tags is string && request.resource.data.tags.size() <= 512
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2000
        && request.resource.data.sortOrder is int
        && request.resource.data.isVisible is bool;
    }
  }
}
